APP_ENV=development
APP_NAME=ByNET API

POSTGRES_USER=bynet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bynet

DATABASE_URL=postgresql+psycopg://bynet:CHANGE_ME@127.0.0.1:5433/bynet

ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]

# PayPal
# Keep disabled until sandbox credentials
# are intentionally configured.
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=10
